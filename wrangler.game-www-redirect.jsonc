{
  // Redirect only published Putt / Sweeper game play URLs to the same apex origin.
  // www.hanage.app's other pages and any existing worker remain untouched.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanage-game-www-redirect",
  "main": "./src/workers/game-www-redirect.ts",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "www.hanage.app/games/putt/play", "zone_name": "hanage.app" },
    { "pattern": "www.hanage.app/games/putt/play/*", "zone_name": "hanage.app" },
    { "pattern": "www.hanage.app/games/multicolor-sweeper/play", "zone_name": "hanage.app" },
    { "pattern": "www.hanage.app/games/multicolor-sweeper/play/*", "zone_name": "hanage.app" }
  ],
  "observability": { "enabled": true }
}
